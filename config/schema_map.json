  "safety": {
    "project_scope": "independent_reporter_only",
    "db_mode": "read_only",
    "sqlite_uri_mode": "ro",
    "pragma_query_only": true,
    "no_writes": [
      "INSERT",
      "UPDATE",
      "DELETE",
      "ALTER",
      "DROP",
      "CREATE INDEX",
      "VACUUM"
    ],
    "do_not_include_tables_in_ai_pack": [
      "users",
      "payments",
      "blockchain_transactions",
      "alembic_version"
    ],
    "do_not_touch_bot_project": true
  },
  "timezone": {
    "report_timezone": "America/Bogota",
    "daily_run_local_time": "05:00",
