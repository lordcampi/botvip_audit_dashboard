# BotVIP / AlphaScalp Audit Dashboard
# Recommended: audit a local copy of production DB for heavy analysis.
# Linux/container example:
# DB_PATH=/app/data/trading_bot.db
# Local copy example:
DB_PATH=./data/trading_bot.db

